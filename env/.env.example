# =====================================================================
# CampusSpace Environment Configuration Template
# Copy this file to .env.local to configure your live deployment.
# =====================================================================

# 1. Supabase Backend Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CAMPUS_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Administrator Identity (Password-Free Flow)
# Registered Administrator Mailbox: campusspaceadmin@gmail.com
ADMIN_EMAIL=campusspaceadmin@gmail.com

# 3. Server-Side Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CampusSpace Security" <no-reply@campusspace.edu>

# Optional: Enable test mode in automated test runners to capture OTPs in memory
# EMAIL_TEST_MODE=true
