# =====================================================================
# CampusSpace Environment Configuration Template
# Copy this file to .env.local to configure your live deployment.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Supabase Backend Configuration
# ---------------------------------------------------------------------
# Supabase Project URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon Public Key (Safe for client-side queries with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Campus Default Timezone (Defaults to Asia/Kolkata)
NEXT_PUBLIC_CAMPUS_TIMEZONE=Asia/Kolkata

# Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# 2. Administrator Identity (Password-Free Flow)
# Registered Administrator Mailbox: campusspaceadmin@gmail.com
# Stored in database record. Admin login requires NO website password.
# ---------------------------------------------------------------------
ADMIN_EMAIL=campusspaceadmin@gmail.com

# ---------------------------------------------------------------------
# 3. Server-Side Nodemailer SMTP Configuration
# Run in server-side Node.js runtime only.
# Used to dispatch Code 1, Code 2, and login confirmation alerts.
# SMTP_PASS is exclusively a backend email-sending credential.
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CampusSpace Security" <no-reply@campusspace.edu>

# Optional: Enable test mode in automated test runners to capture OTPs in memory
# EMAIL_TEST_MODE=true
